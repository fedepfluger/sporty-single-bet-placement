{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /api/matches",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "competition", "kickoffDate", "homeTeam", "awayTeam", "odds"],
    "additionalProperties": true,
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "competition": { "type": "string", "minLength": 1 },
      "kickoffDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
      "homeTeam": { "type": "string", "minLength": 1 },
      "awayTeam": { "type": "string", "minLength": 1 },
      "odds": {
        "type": "object",
        "required": ["home", "draw", "away"],
        "additionalProperties": true,
        "properties": {
          "home": { "type": "number", "minimum": 1.01, "maximum": 1000.0 },
          "draw": { "type": "number", "minimum": 1.01, "maximum": 1000.0 },
          "away": { "type": "number", "minimum": 1.01, "maximum": 1000.0 }
        }
      }
    }
  }
}
