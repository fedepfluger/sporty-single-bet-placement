{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /api/place-bet (200)",
  "type": "object",
  "required": ["message", "matchId", "selection", "stake", "odds", "payout", "balance", "currency"],
  "additionalProperties": true,
  "properties": {
    "message": { "type": "string", "minLength": 1 },
    "matchId": { "type": "string", "minLength": 1 },
    "selection": { "type": "string", "enum": ["HOME", "DRAW", "AWAY"] },
    "stake": { "type": "number", "exclusiveMinimum": 0, "maximum": 100.0 },
    "odds": { "type": "number", "minimum": 1.01, "maximum": 1000.0 },
    "payout": { "type": "number", "exclusiveMinimum": 0 },
    "balance": { "type": "number", "minimum": 0 },
    "currency": { "type": "string", "const": "EUR" }
  }
}
