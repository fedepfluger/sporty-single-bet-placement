# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in USER_ID. Everything else already carries
# the value for the assignment environment.
#
# `.env` is git-ignored on purpose: no secret ever belongs in the repository.
# In CI, provide the secrets as encrypted repository secrets and the rest as
# repository variables. An empty value behaves as if the variable were absent,
# so `.env` still supplies it.
#
# Values marked REQUIRED have no fallback in code: `config/settings.py` raises a
# named error if they are missing. That is deliberate - a default in code is a
# value that silently survives a misconfigured environment, and this suite
# asserts money rules.
# ---------------------------------------------------------------------------

# --- Application under test (REQUIRED) -------------------------------------
BASE_URL=https://qae-assignment-tau.vercel.app
API_BASE_URL=https://qae-assignment-tau.vercel.app/api

# --- Identities -------------------------------------------------------------
# REQUIRED and SECRET - never commit the real value.
# Sent to the API as the `x-user-id` header and to the UI as the `user-id` query param.
USER_ID=

# REQUIRED. A well-formed id that was never provisioned, for the user-isolation
# test. It must NOT resolve to a real account.
UNKNOWN_USER_ID=qa-unknown-user-00000000-0000-4000-8000-000000000000

# --- Business rules, Feature Specification section 3 (REQUIRED) -------------
# The suite asserts these limits, so they are configuration rather than
# constants: a platform change is an environment change, not a code change.
INITIAL_BALANCE=125.50
CURRENCY=EUR
STAKE_MIN=1.00
STAKE_MAX=100.00
STAKE_DECIMALS=2
ODDS_MIN=1.01
ODDS_MAX=1000.00

# --- Browser / WebDriver (optional: how we drive it, not what it is) --------
BROWSER=chrome
HEADLESS=true
WINDOW_WIDTH=1440
WINDOW_HEIGHT=900
EXPLICIT_WAIT=15
PAGE_LOAD_TIMEOUT=30
# Console level captured for failure evidence: SEVERE, WARNING, INFO or ALL.
BROWSER_LOG_LEVEL=SEVERE
# Pins the locale the application sees, so formatting is identical everywhere.
# Comma-separated, most preferred first. Examples: en-US,en | es-AR,es | fr-FR,fr
BROWSER_LANGUAGES=en-GB,en
